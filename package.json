{
  "name": "base-segura",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:content": "markdownlint-cli2 'content/**/*.md'",
    "validate": "tsx scripts/validate-content.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "analyze": "ANALYZE=true next build",
    "check": "npm run lint:content && npm run validate && npm run format:check && npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "gray-matter": "4.0.3",
    "next": "15.5.22",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.1",
    "unified": "11.0.5",
    "zod": "3.23.8"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "prettier --write"
    ],
    "content/**/*.md": [
      "markdownlint-cli2"
    ]
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@next/bundle-analyzer": "16.2.12",
    "@types/node": "20.19.43",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.22",
    "husky": "9.1.7",
    "lint-staged": "17.2.0",
    "markdownlint-cli2": "0.23.1",
    "postcss": "8.5.23",
    "prettier": "3.9.6",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
